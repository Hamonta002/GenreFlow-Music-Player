{
    "manifest_version":  3,
    "name":  "GenreFlow Music Player",
    "version":  "3.1.0",
    "description":  "A genre-based online music and radio player that keeps playing in the background.",
    "permissions":  [
                        "storage",
                        "sidePanel",
                        "offscreen"
                    ],
    "host_permissions":  [
                             "https://*.api.radio-browser.info/*",
                             "https://api.audius.co/*",
                             "https://api.jamendo.com/*",
                             "http://*/*",
                             "https://*/*"
                         ],
    "action":  {
                   "default_title":  "Open GenreFlow"
               },
    "side_panel":  {
                       "default_path":  "sidepanel.html"
                   },
    "background":  {
                       "service_worker":  "background.js",
                       "type":  "module"
                   },
    "icons":  {
                  "16":  "icon16.png",
                  "32":  "icon32.png",
                  "48":  "icon48.png",
                  "128":  "icon128.png"
              }
}
